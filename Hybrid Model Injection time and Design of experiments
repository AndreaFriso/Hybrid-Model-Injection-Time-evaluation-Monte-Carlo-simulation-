def mc_theta(theta, speed, travel, N=5000):
    sigma = 0.1 * theta
    sims = [
        friction_mechanistic(speed, travel, np.random.normal(theta, sigma))
        for _ in range(N)
    ]
    sims = np.array(sims)
    return sims.mean(axis=0), sims.std(axis=0)

