def build_ann(input_dim, dropout=0.5):
    model = Sequential([
        Input(shape=(input_dim,)),
        Dense(64, activation="relu"),
        Dropout(dropout),
        Dense(64, activation="relu"),
        Dropout(dropout),
        Dense(1)
    ])
    model.compile(optimizer=Adam(1e-3), loss="mse")
    return model

